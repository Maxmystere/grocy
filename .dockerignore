# Composer vendor directory (regenerated by `composer install` during build)
/packages

# Frontend node_modules / installed packages (regenerated by `yarn install`)
/public/packages
node_modules

# SQLite databases and runtime data (should not be baked into the image)
/data/*.db
/data/viewcache
/data/backups

# Git metadata
.git
.gitignore
.gitattributes

# Editor / IDE files
.vscode
.idea
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db
